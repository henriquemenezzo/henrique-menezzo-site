 * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))"><img src="/img/dare-01-1536.webp" srcset="/img/dare-01-768.webp 768w, /img/dare-01-1536.webp 1536w" sizes="(min-width: 1440px) max(100vw, calc(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))" width="1536" height="1024" alt="" decoding="async" fetchpriority="high"></picture><div class="f-khgu6"><div data-speed="50" class="f-7t8qxr"><picture class="bg"><source type="image/avif" srcset="/img/home-05-750.avif 750w" sizes="(min-width: 1440px) max(306.4672px, calc(100vw * 306.4672 / 1500)), (min-width: 1200px) and (max-width: 1439.98px) 306.4672px, (max-width: 767.98px) 170.5895px, (min-width: 768px) and (max-width: 1199.98px) 250.5323px"><img src="/img/home-05-750.webp" srcset="/img/home-05-750.webp 750w" sizes="(min-width: 1440px) max(306.4672px, calc(100vw * 306.4672 / 1500)), (min-width: 1200px) and (max-width: 1439.98px) 306.4672px, (max-width: 767.98px) 170.5895px, (min-width: 768px) and (max-width: 1199.98px) 250.5323px" width="750" height="1624" alt="" decoding="async" fetchpriority="high"></picture></div><div data-speed="50" class="f-1wxmcts"><picture class="bg"><source type="image/avif" srcset="/img/home-06-750.avif 750w" sizes="(min-width: 1440px) max(307.2571px, calc(100vw * 307.2571 / 1500)), (min-width: 1200px) and (max-width: 1439.98px) 307.2571px, (max-width: 767.98px) 171.7742px, (min-width: 768px) and (max-width: 1199.98px) 250.5323px"><img src="/img/home-06-750.webp" srcset="/img/home-06-750.webp 750w" sizes="(min-width: 1440px) max(307.2571px, calc(100vw * 307.2571 / 1500)), (min-width: 1200px) and (max-width: 1439.98px) 307.2571px, (max-width: 767.98px) 171.7742px, (min-width: 768px) and (max-width: 1199.98px) 250.5323px" width="750" height="1624" alt="" decoding="async" fetchpriority="high"></picture></div></div><div style="transform:scale(1.08)" class="f-17d1ch2 a-settle"></div><div class="f-dqiai8"><div class="f-1rkq0kx rt a-rise"><h1 class="p-2d95uh t1">Dare</h1></div><div class="f-8zxfd7 rt a-rise"><h2 class="p-1sbqppe t1">Improving the perception of sports competition through Interaction Design</h2></div></div></div><div class="f-2ioc80"><div data-speed="108" data-speed-p="104" data-speed-t="100" class="f-a9xkli b1"><div class="f-1hx79z9"><div class="f-1jg7h4z rt"><p class="t2">My role</p></div><div class="f-vp5npl rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b2">Product Designer</p></div></div><div class="f-1pekwhs"><div class="f-1g23cwa rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b3">Challenge</p></div><div class="f-9z9ol2 rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b4">Our challenge was to design a new and engaging home‑screen interaction where users compare two performances and vote for the best, in order to impress an investor and deliver a strong user experience.</p></div></div><div class="f-1livwwx"><div class="f-x38vgr rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b5">Result</p></div><div class="f-1byy8ib rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b6"><strong>5 Stars on the Apple store with 20+ good reviews</strong>. The improved interaction <strong>raised satisfaction from 7.6 to 9.0</strong>, <strong>ease of use from 7.2 to 9.5</strong>, and <strong>reduced the time to understand how to switch videos from 33.5 seconds to just 8</strong>, while keeping the same “wow” effect and competitive feeling.</p></div></div><div class="f-16e1yxd"><div class="f-1r24olz rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b7">Deliverables</p></div><div class="f-16zfswp rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b8">Product Design, Interaction Design, Tests, A/B Testing, Usability Testing</p></div></div></div><div class="f-xbqoq1"><div data-speed="108" data-speed-p="104" data-speed-t="100" class="f-1n2q0yo b9"><div class="f-7rdamk"><div class="f-1pv1qvt"></div></div><div class="f-1fp2nr4 rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b10">At Dare, the focus was simple: transforming the act of voting in a sports challenge into a truly competitive experience.</p><p style="font-family:var(--book);line-height:1.5;color:#000" class="b11">The key point was the real-time voting moment, where the user watched two athletes perform and decided who did better.</p></div></div><div class="f-1m9es26"><div data-speed="96" data-speed-p="100" data-speed-t="100" class="f-l94j30 rt b12"><p class="t3">To solve the challenge, I aligned with stakeholders and we agreed to focus on user experience, not just investor impact.</p><p class="t3">I explored a stories-style approach, inspired by apps like TikTok and Instagram, where videos play in sequence.</p><p class="t3">This interaction is immersive, fast, and distraction-free based on habits users already know.</p><p class="t3">The idea was to test if this continuous video flow would drive curiosity and keep users moving through challenges naturally.</p><p class="t3">I used references from Tinder, Netflix, Mobbin, and Dribbble, then created and tested this version in Maze.</p></div><div class="f-1walhrg hidden-xjb81m"><picture class="bg"><source type="image/avif" srcset="/img/dare-02-768.avif 768w, /img/dare-02-1536.avif 1536w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (max-width: 767.98px) min(100vw - 48px, 1400px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px)"><img src="/img/dare-02-1536.webp" srcset="/img/dare-02-768.webp 768w, /img/dare-02-1536.webp 1536w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (max-width: 767.98px) min(100vw - 48px, 1400px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px)" width="1536" height="1024" alt="" decoding="async" loading="lazy"></picture><div class="f-1cacwim-container"><video data-src="/video/dare-09.mp4" data-poster="/video/dare-09.avif" width="864" height="1900" loop="" muted="" playsinline="" preload="none" style="border-radius:8px"></video></div></div><div class="f-lktny8 hidden-15d91jf hidden-lh49dm hidden-121ldz9 hidden-65sw25 hidden-1jgfseo"><picture class="bg"><source type="image/avif" srcset="/img/dare-03-700.avif 700w, /img/dare-03-1400.avif 1400w" sizes="(min-width: 1440px) 100vw, (min-width: 1200px) and (max-width: 1439.98px) 100vw, (min-width: 768px) and (max-width: 1199.98px) 100vw, (max-width: 767.98px) 100vw"><img src="/img/dare-03-1400.webp" srcset="/img/dare-03-700.webp 700w, /img/dare-03-1400.webp 1400w" sizes="(min-width: 1440px) 100vw, (min-width: 1200px) and (max-width: 1439.98px) 100vw, (min-width: 768px) and (max-width: 1199.98px) 100vw, (max-width: 767.98px) 100vw" width="1400" height="933" alt="" decoding="async" loading="lazy"></picture><div style="transform:translate(-50%, -50%)" class="f-1fmzu8i"><div class="bg"><video data-src="/video/dare-10.mp4" data-poster="/video/dare-10.avif" width="342" height="754" loop="" muted="" playsinline="" preload="none"></video></div></div></div></div><div class="f-7fsbm7"><div class="f-rvjng6 hidden-xjb81m"><picture class="bg"><source type="image/avif" srcset="/img/dare-04-768.avif 768w, /img/dare-04-1536.avif 1536w" sizes="(min-width: 1440px) max(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), 100vw), (min-width: 1200px) and (max-width: 1439.98px) max(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), 100vw), (max-width: 767.98px) max(min(100vw - 48px, 1400px), 100vw), (min-width: 768px) and (max-width: 1199.98px) max(min(100vw - 64px, 1400px), 100vw)"><img src="/img/dare-04-1536.webp" srcset="/img/dare-04-768.webp 768w, /img/dare-04-1536.webp 1536w" sizes="(min-width: 1440px) max(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), 100vw), (min-width: 1200px) and (max-width: 1439.98px) max(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), 100vw), (max-width: 767.98px) max(min(100vw - 48px, 1400px), 100vw), (min-width: 768px) and (max-width: 1199.98px) max(min(100vw - 64px, 1400px), 100vw)" width="1536" height="1024" alt="" decoding="async" loading="lazy"></picture><div class="f-1stkgik-container"><video data-src="/video/dare-11.mp4" data-poster="/video/dare-11.avif" width="864" height="1900" loop="" muted="" playsinline="" preload="none" style="border-radius:8px"></video></div></div><div data-speed="96" data-speed-p="100" data-speed-t="100" class="f-7h2n58 rt b13"><p class="t3">In this second exploration, I placed both athletes side by side to let users compare their moves visually.</p><p class="t3">The idea was to create a more intense and competitive experience, bringing a clear “versus” feeling to the screen.</p><p class="t3">This direction aimed to test whether having both videos on screen at the same time would create stronger emotional engagement and make voting feel more instinctive.</p></div><div class="f-13w0hu2 hidden-15d91jf hidden-lh49dm hidden-121ldz9 hidden-65sw25 hidden-1jgfseo"><picture class="bg"><source type="image/avif" srcset="/img/dare-04-768.avif 768w, /img/dare-04-1536.avif 1536w" sizes="(min-width: 1440px) max(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), 100vw), (min-width: 1200px) and (max-width: 1439.98px) max(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), 100vw), (max-width: 767.98px) max(min(100vw - 48px, 1400px), 100vw), (min-width: 768px) and (max-width: 1199.98px) max(min(100vw - 64px, 1400px), 100vw)"><img src="/img/dare-04-1536.webp" srcset="/img/dare-04-768.webp 768w, /img/dare-04-1536.webp 1536w" sizes="(min-width: 1440px) max(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), 100vw), (min-width: 1200px) and (max-width: 1439.98px) max(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), 100vw), (max-width: 767.98px) max(min(100vw - 48px, 1400px), 100vw), (min-width: 768px) and (max-width: 1199.98px) max(min(100vw - 64px, 1400px), 100vw)" width="1536" height="1024" alt="" decoding="async" loading="lazy"></picture><div style="transform:translate(-50%, -50%)" class="f-v0ubpq"><div class="bg"><video data-src="/video/dare-12.mp4" data-poster="/video/dare-12.avif" width="342" height="754" loop="" muted="" playsinline="" preload="none"></video></div></div></div></div></div><div class="f-1ddk7tb"><div class="ssr-variant hidden-121ldz9 hidden-lh49dm"><div data-speed="103" data-speed-p="101" data-speed-t="100" class="f-1v4gjdt"><div class="f-1fiaqvr"><div class="f-1e18udz"></div></div><div class="f-lxsssu"><div class="f-4wnhbn rt"><p class="t4">Unveiling the user’s feelings</p></div><div class="ssr-variant hidden-1jgfseo"><div class="f-1b7gw0y rt"><p class="t5">I conducted exploratory tests not only to measure clicks but to understand users’ emotions and perceptions while interacting with both versions, identifying in which one they felt more comfortable and motivated to keep using the app with the WOW moment.</p></div></div><div class="ssr-variant hidden-15d91jf hidden-65sw25 hidden-xjb81m"><div class="f-1b7gw0y rt"><p class="t3">I conducted exploratory tests not only to measure clicks but to understand users’ emotions and perceptions while interacting with both versions, identifying in which one they felt more comfortable and motivated to keep using the app with the WOW moment.</p></div></div></div></div></div><div class="ssr-variant hidden-15d91jf hidden-65sw25 hidden-lh49dm hidden-1jgfseo hidden-xjb81m"><div data-speed="103" data-speed-p="101" data-speed-t="100" class="f-1v4gjdt"><div class="f-1fiaqvr"><div class="f-1e18udz"></div></div><div class="f-lxsssu"><div class="f-4wnhbn rt"><p class="t6">Unveiling the user’s feelings</p></div><div class="f-1b7gw0y rt"><p class="t5">I conducted exploratory tests not only to measure clicks but to understand users’ emotions and perceptions while interacting with both versions, identifying in which one they felt more comfortable and motivated to keep using the app with the WOW moment.</p></div></div></div></div><div class="ssr-variant hidden-15d91jf hidden-121ldz9 hidden-65sw25 hidden-1jgfseo hidden-xjb81m"><div data-speed="103" data-speed-p="101" data-speed-t="100" class="f-1v4gjdt"><div class="f-1fiaqvr"><div class="f-1e18udz"></div></div><div class="f-lxsssu"><div class="f-4wnhbn rt"><p class="t7">Unveiling the user’s feelings</p></div><div class="f-1b7gw0y rt"><p class="t5">I conducted exploratory tests not only to measure clicks but to understand users’ emotions and perceptions while interacting with both versions, identifying in which one they felt more comfortable and motivated to keep using the app with the WOW moment.</p></div></div></div></div><div class="f-1g55qvc"><div data-speed="96" data-speed-p="100" data-speed-t="100" class="f-1jaehc9 rt b14"><p class="t3">In the test, many users said they needed a short tutorial to know how to switch videos.<br><br></p><p class="t3">The second version got:</p><p class="t3"><strong>7.6 satisfaction, 7.2 ease of use, and users took 33.5 seconds to understand how to switch</strong>, while the first version had better scores (8.8 and 8.0), but took 76 seconds to understand.</p><p class="t3">Still, 60% preferred the second version.<br><br></p><p class="t3">“The first one looked cooler, but the second was easier to use.”<br><br></p><p class="t3">This showed us that clarity, speed and a wow effect were more important than a perfect flow.</p><p class="t5"><br></p></div><div class="f-vlk2hh"><div class="f-885rm6"><div class="f-1928ucm"><picture class="bg"><source type="image/avif" srcset="/img/dare-05-484.avif 484w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 185.5px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))"><img src="/img/dare-05-484.webp" srcset="/img/dare-05-484.webp 484w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 185.5px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))" width="484" height="1048" alt="" decoding="async" loading="lazy"></picture></div><div class="f-l0jul2"><picture class="bg"><source type="image/avif" srcset="/img/dare-06-484.avif 484w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 185px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))"><img src="/img/dare-06-484.webp" srcset="/img/dare-06-484.webp 484w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 185px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))" width="484" height="1048" alt="" decoding="async" loading="lazy"></picture></div><div class="f-zw9i0u"><picture class="bg"><source type="image/avif" srcset="/img/dare-07-396.avif 396w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 184.5px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))"><img src="/img/dare-07-396.webp" srcset="/img/dare-07-396.webp 396w" sizes="(min-width: 1200px) and (max-width: 1439.98px) 184.5px, (max-width: 767.98px) 129.447px, (min-width: 768px) and (max-width: 1199.98px) 174.9006px, (min-width: 1440px) max(241px, calc(100vw * 241 / 1500))" width="396" height="858" alt="" decoding="async" loading="lazy"></picture></div></div></div></div></div><div class="f-1r9omue"><div data-speed="103" data-speed-p="101" data-speed-t="100" class="f-mpf86z b15"><div class="f-zi4p6w"><div class="f-dnw004"></div></div><div class="f-1gp1fhk"><div class="f-bn9pn2 rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b16">Increasing the sense of competition</p></div><div class="f-18lqpon rt"><p class="t3">In the tests, we noticed that users preferred the second option — the one where it was possible to swipe sideways and view the other competitor. However, it still presented some challenges: the visible area of the second video was small, the “VS” element had little visual presence, and the voting buttons were too discreet.</p></div></div></div><div class="f-111e41e"><div class="f-n8w8nm"><div class="ssr-variant hidden-121ldz9 hidden-65sw25 hidden-lh49dm hidden-xjb81m"><div class="f-abim9n"><picture class="bg"><source type="image/avif" srcset="/img/dare-01-768.avif 768w, /img/dare-01-1536.avif 1536w" sizes="(min-width: 1440px) max(100vw, calc(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))"><img src="/img/dare-01-1536.webp" srcset="/img/dare-01-768.webp 768w, /img/dare-01-1536.webp 1536w" sizes="(min-width: 1440px) max(100vw, calc(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))" width="1536" height="1024" alt="" decoding="async" loading="lazy"></picture><div style="transform:translate(-50%, -50%)" class="f-1bzyb14"><div class="bg"><video data-src="/video/dare-13.mp4" data-poster="/video/dare-13.avif" width="342" height="754" loop="" muted="" playsinline="" preload="none"></video></div></div></div></div><div class="ssr-variant hidden-15d91jf hidden-1jgfseo"><div class="f-abim9n"><picture class="bg"><source type="image/avif" srcset="/img/dare-01-768.avif 768w, /img/dare-01-1536.avif 1536w" sizes="(min-width: 1440px) max(100vw, calc(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))"><img src="/img/dare-01-1536.webp" srcset="/img/dare-01-768.webp 768w, /img/dare-01-1536.webp 1536w" sizes="(min-width: 1440px) max(100vw, calc(max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))) * 0.9994)), (min-width: 1200px) and (max-width: 1439.98px) max(100vw, calc(max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px) * 0.9994)), (min-width: 768px) and (max-width: 1199.98px) max(100vw, calc(min(100vw - 64px, 1400px) * 0.9994)), (max-width: 767.98px) max(100vw, calc(min(100vw - 48px, 1400px) * 0.9994))" width="1536" height="1024" alt="" decoding="async" loading="lazy"></picture><div style="transform:translate(-50%, -50%)" class="f-1bzyb14"><div class="bg"><video data-src="/video/dare-13.mp4" data-poster="/video/dare-13.avif" width="342" height="754" loop="" muted="" playsinline="" preload="none"></video></div></div></div></div></div><div data-speed="99" data-speed-p="101" data-speed-t="100" class="f-tkybqe rt b17"><p class="t3">After that, I improved the second screen by adding tutorials, animations, and clearer interactions.</p><p class="t3">In the next test:</p><p class="t3"><strong>Satisfaction went up to 9.0, ease of use to 9.5, and users understood how to switch videos in just 8 seconds.</strong><strong><br></strong><br></p><p class="t3">We kept the same “wow” moment and sense of competition, our main goal.</p></div></div><div data-speed="99" class="f-d8n1dx rt"><p class="t3">The app is currently live and has been receiving extremely positive feedback from content creators. It now holds a <strong>5/5 rating on the App Store and 20+ reviews</strong>, with highlights for the clarity of the experience and the sense of motivation created by the interactions.</p><p class="t3">This experience showed me in practice how interaction and emotional design can transform something simple, like voting on videos, into a truly engaging dynamic.</p><p class="t3">In addition to this stage, I also contributed with the Dare team to other app experiences, always exploring new ways to make sports competitions more fun and intuitive.</p></div></div><div class="ssr-variant hidden-121ldz9"><div data-cursor-card="" class="f-16nikiq-container"><a href="/goldcare" style="max-width:100%;width:100%" class="f-1s3v5ik f-v-1a7rfw5 f-e7xpzw"><div class="f-1q6x1ck"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-12chao9"></div></div><div class="f-f5lzqk"><div class="f-foi0ng rt"><h1 class="p-2d95uh t8">Goldcare</h1></div><div class="f-1qalqtu rt"><p class="t9">Next project</p></div></div><div class="f-2h2af"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-19yczr0"></div></div></a></div></div><div class="ssr-variant hidden-15d91jf hidden-65sw25 hidden-lh49dm hidden-1jgfseo hidden-xjb81m"><div class="f-16nikiq-container"><a href="/goldcare" style="max-width:100%;width:100%" class="f-1s3v5ik f-v-1u7ogt4 f-e7xpzw"><div class="f-1q6x1ck"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-12chao9"></div></div><div class="f-f5lzqk"><div class="f-foi0ng rt"><h1 class="p-2d95uh t8">Goldcare</h1></div><div class="f-1qalqtu rt"><p class="t10">Next project</p></div></div><div class="f-2h2af"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-19yczr0"></div></div><div class="f-eoy0l3"><picture class="bg"><source type="image/avif" srcset="/img/home-09-417.avif 417w" sizes="(max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/home-09-417.webp" srcset="/img/home-09-417.webp 417w" sizes="(max-width: 767.98px) min(100vw - 48px, 1400px)" width="417" height="626" alt="" decoding="async" loading="lazy"></picture><div style="border-radius:8px" class="f-1yhqbjk"><picture class="bg"><source type="image/avif" srcset="/img/dare-08-604.avif 604w" sizes="(max-width: 767.98px) 201px"><img src="/img/dare-08-604.webp" srcset="/img/dare-08-604.webp 604w" sizes="(max-width: 767.98px) 201px" width="604" height="1084" alt="" decoding="async" loading="lazy"></picture></div><div style="border-top-left-radius:8px;border-top-right-radius:8px;box-shadow:0px 1px 20px 0px rgba(0, 0, 0, 0.25)" class="f-zw0i5s"><picture class="bg"><source type="image/avif" srcset="/img/home-10-512.avif 512w, /img/home-10-1024.avif 1024w" sizes="(max-width: 767.98px) 180px"><img src="/img/home-10-1024.webp" srcset="/img/home-10-512.webp 512w, /img/home-10-1024.webp 1024w" sizes="(max-width: 767.98px) 180px" width="1024" height="1691" alt="" decoding="async" loading="lazy"></picture></div></div></a></div></div></div><div class="f-roc2i8-container"></div><Footer /></div>
