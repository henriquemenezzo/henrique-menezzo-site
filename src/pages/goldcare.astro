1500)), (min-width: 1200px) and (max-width: 1439.98px) 792px, (min-width: 768px) and (max-width: 1199.98px) 529px, (max-width: 767.98px) 337px"><img src="/img/home-10-1024.webp" srcset="/img/home-10-512.webp 512w, /img/home-10-1024.webp 1024w" sizes="(min-width: 1440px) max(792px, calc(100vw * 792 / 1500)), (min-width: 1200px) and (max-width: 1439.98px) 792px, (min-width: 768px) and (max-width: 1199.98px) 529px, (max-width: 767.98px) 337px" width="1024" height="1691" alt="" decoding="async" fetchpriority="high"></picture></div></div><div style="transform:scale(1.08)" class="f-xc2b6s a-settle"></div><div class="f-1s80tbh"><div class="f-mga83c rt a-rise"><h1 class="p-2d95uh t1">Goldcare</h1></div><div class="f-1g941rz rt a-rise"><h2 class="p-1sbqppe t1">How a Scalable Design System Saved $45k/Year in Development Costs</h2></div></div></div><div class="f-pysvkx"><div data-speed="108" data-speed-t="100" data-speed-p="104" class="f-4mz28e b1"><div class="f-p7hpb4"><div class="f-1ouzwbn rt"><p class="t2">My Role</p></div><div class="f-1l2bljd rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b2">UI Design - Design System Specialist</p></div></div><div class="f-1r89ydn"><div class="f-17niw9g rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b3">Challenge</p></div><div class="f-1i0opo6 rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b4">Build a scalable Design System to eliminate inconsistencies and reduce rework between Design and Engineering.</p></div></div><div class="f-1rdqvir"><div class="f-1m3lgnx rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b5">Result</p></div><div class="f-1f3vvt4 rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b6">Design System reducing development and support hours, generating an estimated annual savings of $45,000 and a positive ROI of +$40,000 within the first year.</p></div></div><div class="f-vuelug"><div class="f-gs123o rt"><p style="font-family:var(--medium);color:#000;font-weight:500" class="b7">Deliverables</p></div><div class="f-miy79v rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b8">Design System, UI Design, Tokens, Components, Documentation, Research</p></div></div></div><div class="f-nwq70g"><div data-speed="108" data-speed-t="100" data-speed-p="104" class="f-14atfn0 b9"><div class="f-1dbnxkw"><div class="f-1v8nb2f"></div></div><div class="f-w8u8o rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b10">As the company grew, each designer created interfaces in different ways, resulting in inconsistencies and rework between Design and Engineering.</p><p style="font-family:var(--book);line-height:1.5;color:#000" class="b11">At Goldcare, this led to misaligned interfaces and unnecessary operational costs.</p></div></div><div class="f-1qe9uui"><div data-speed="96" data-speed-t="100" data-speed-p="100" class="f-xzt4gi rt b12"><p class="t3">I started by identifying which components and tokens generated the most inconsistencies and rework.</p><p class="t4"><br></p><p class="t3">During internal research, I found dissatisfaction regarding collaboration between teams, especially in UI handoffs.</p><p class="t4"><br></p><p class="t3">Most people reported a lack of standardization in sizes, colors, icons, buttons, and inputs, as well as difficulty locating specific interactions in Figma.</p></div><div class="f-1i178l5"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-01-1500.avif 1500w, /img/goldcare-01-2999.avif 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-01-2999.webp" srcset="/img/goldcare-01-1500.webp 1500w, /img/goldcare-01-2999.webp 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)" width="2999" height="1656" alt="" decoding="async" loading="lazy"></picture></div></div><div class="f-78o24m"><div class="f-hyf3m6"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-02-1500.avif 1500w, /img/goldcare-02-2999.avif 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-02-2999.webp" srcset="/img/goldcare-02-1500.webp 1500w, /img/goldcare-02-2999.webp 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)" width="2999" height="1656" alt="" decoding="async" loading="lazy"></picture></div><div data-speed="96" data-speed-t="100" data-speed-p="100" class="f-1gjp07l rt b13"><p class="t3">Even the simplest components were created manually.</p><p class="t4"><br></p><p class="t3">Buttons and inputs were repeated more than 400 times across different screens, resulting in over 1,200 hours of rework and an annual cost of $45,000 just for these components.</p><p class="t4"><br></p><p class="t3">Meanwhile, users needed new features, and the product was already in production.</p></div></div><div class="f-w45gjb"><div class="f-1nmq24g"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-03-966.avif 966w, /img/goldcare-03-1932.avif 1932w" sizes="(min-width: 1440px) max((min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) - max(24px, calc(100vw * 24 / 1500))) / 2, max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max((min(100vw - 96px, 1400px) - 24px) / 2, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-03-1932.webp" srcset="/img/goldcare-03-966.webp 966w, /img/goldcare-03-1932.webp 1932w" sizes="(min-width: 1440px) max((min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) - max(24px, calc(100vw * 24 / 1500))) / 2, max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max((min(100vw - 96px, 1400px) - 24px) / 2, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)" width="1932" height="1067" alt="" decoding="async" loading="lazy"></picture></div><div class="f-uxeaqf"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-04-966.avif 966w, /img/goldcare-04-1932.avif 1932w" sizes="(min-width: 1440px) max((min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) - max(24px, calc(100vw * 24 / 1500))) / 2, max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max((min(100vw - 96px, 1400px) - 24px) / 2, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-04-1932.webp" srcset="/img/goldcare-04-966.webp 966w, /img/goldcare-04-1932.webp 1932w" sizes="(min-width: 1440px) max((min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) - max(24px, calc(100vw * 24 / 1500))) / 2, max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max((min(100vw - 96px, 1400px) - 24px) / 2, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)" width="1932" height="1067" alt="" decoding="async" loading="lazy"></picture></div></div></div><div class="f-yzj9ml"><div data-speed="103" data-speed-t="100" data-speed-p="101" class="f-1olz3qs b14"><div class="f-8eh0pi"><div class="f-1j8p2y3"></div></div><div class="f-1ddmkxx"><div class="f-19md3iz rt"><p style="font-family:var(--book);line-height:1.5;color:#000" class="b15">Defining principles and promoting consistency</p></div><div class="f-e0w6vl rt"><p class="t4">After identifying the main problems, I realized it was essential to build a new design system from scratch — one that could meet the needs of the business, users, and the team. The process involved defining principles, creating tokens, and standardizing components.</p></div></div></div><div class="f-scabpj"><div data-speed="98" data-speed-t="100" data-speed-p="100" class="f-s9sxpr rt b16"><p class="t3">Before, the interface was entirely black and white, and the gold color appeared only in the logo, without reinforcing the brand’s premium positioning.</p><p class="t4"><br></p><p class="t3">Based on user research and company metrics, we defined new principles guided by semantics and accessibility.</p><p class="t4"><br></p><p class="t3">Gold became an emphasis token, while black was reserved for maximum readability. The color stopped being purely aesthetic and became functional within the Design System.</p></div><div class="f-yggpdq-container"><video data-src="/video/goldcare-07.mp4" data-poster="/video/goldcare-07.avif" width="1708" height="1080" loop="" muted="" playsinline="" preload="none"></video></div></div><div class="f-1fs7kp"><div class="f-qy6ikg-container"><video data-src="/video/goldcare-08.mp4" data-poster="/video/goldcare-08.avif" width="1794" height="1080" loop="" muted="" playsinline="" preload="none"></video></div><div data-speed="98" data-speed-t="100" data-speed-p="100" class="f-1g5kjrf rt b17"><p class="t3">I worked on the tokens together with the developers from the beginning, ensuring compatibility with the standard they were already using in Chakra UI.</p><p class="t4"><br></p><p class="t3">First, I adjusted taxonomies, sizes, spacings, and colors to mirror what existed in the code, this step formed the primitive tokens.</p><p class="t4"><br></p><p class="t3">Then, I evolved them into semantic tokens, creating clear and intuitive names for both devs and designers. We tested the tokens directly in the screens to ensure anyone could understand and apply them without friction.</p></div></div><div class="f-16343ob-container"><video data-src="/video/goldcare-09.mp4" data-poster="/video/goldcare-09.avif" width="1794" height="1080" loop="" muted="" playsinline="" preload="none"></video></div></div><div class="f-1dcrd57"><div class="ssr-variant hidden-il429r"><div data-speed="101" data-speed-t="100" class="f-1q5dwqt"><div class="f-ls4idx"><div class="f-tt90p3"></div></div><div class="f-tyq7cd"><div class="ssr-variant hidden-11vjef6"><div class="f-1u728k7 rt"><p class="t5">From chaos to clarity</p></div></div><div class="ssr-variant hidden-u7rrgr hidden-9p0tyo hidden-1fvlfgk hidden-1nmiogt"><div class="f-1u728k7 rt"><p class="t6">From chaos to clarity</p></div></div><div class="f-4zg0lt rt"><p class="t3">After mapping processes, identifying visual inconsistencies, and aligning expectations with the team, we transformed Goldcare’s design into an organized, scalable system guided by documentation.</p><p class="t3">The Design System not only brought consistency, but also enabled faster development of new features and saved $45,000 per year in development costs.</p></div></div></div></div><div class="ssr-variant hidden-u7rrgr hidden-9p0tyo hidden-1fvlfgk hidden-11vjef6 hidden-1nmiogt"><div data-speed="101" data-speed-t="100" class="f-1q5dwqt"><div class="f-ls4idx"><div class="f-tt90p3"></div></div><div class="f-tyq7cd"><div class="f-1u728k7 rt"><p class="t7">From chaos to clarity</p></div><div class="f-4zg0lt rt"><p class="t3">After mapping processes, identifying visual inconsistencies, and aligning expectations with the team, we transformed Goldcare’s design into an organized, scalable system guided by documentation.</p><p class="t3">The Design System not only brought consistency, but also enabled faster development of new features and saved $45,000 per year in development costs.</p></div></div></div></div><div class="f-dt8d8w"><div style="height:auto;aspect-ratio:1.547" class="f-17ui4s3"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-05-1500.avif 1500w, /img/goldcare-05-2999.avif 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-05-2999.webp" srcset="/img/goldcare-05-1500.webp 1500w, /img/goldcare-05-2999.webp 2999w" sizes="(min-width: 1440px) max(min(100vw - max(96px, calc(100vw * 96 / 1500)), max(1400px, calc(100vw * 1400 / 1500))) * 0.8495 - max(32px, calc(100vw * 32 / 1500)), max(1px, calc(100vw * 1 / 1500))), (min-width: 1200px) and (max-width: 1439.98px) max(min(100vw - 96px, 1400px) * 0.8495 - 32px, 1px), (min-width: 768px) and (max-width: 1199.98px) min(100vw - 64px, 1400px), (max-width: 767.98px) min(100vw - 48px, 1400px)" width="2999" height="1937" alt="" decoding="async" loading="lazy"></picture></div><div data-speed="99" data-speed-t="100" data-speed-p="101" class="f-dlijqk rt b18"><p class="t3">Today, Goldcare uses the standards we defined from the beginning, Design System, tokens, UI guidelines, and organized documentation.</p><p class="t3">The main gains were:</p><p class="t3">• Scalability: any designer can maintain the same visual standard.</p><p class="t3">• Speed: less rework and faster deliveries.</p><p class="t3">• Savings: reduction in development and maintenance hours.</p><p class="t3">The Design System has become part of the company’s process, serving as a foundation for platform evolution and strengthening the brand’s presence in the digital space.</p></div></div><div data-speed="99" class="f-1tpvbbg rt"><p class="t3">Working at Goldcare showed me, in a very practical way, that standardization is not about limiting creativity, it’s about removing complexity. When we build solid, well-thought-out components, we save hours, sometimes days, of future development.</p><p class="t3">I also realized that documentation is not a bureaucratic detail: it prevents subjective decisions, reduces rework, and gives the team autonomy to evolve the product without depending on the original designer.</p><p class="t3">In the end, I understood that design goes far beyond aesthetics. It is clarity, efficiency, and real business impact. When design makes people’s work easier and accelerates the company’s pace, that’s when it fulfills its true purpose.</p></div></div><div class="ssr-variant hidden-11vjef6"><div data-cursor-card="" class="f-vafqxo-container"><a href="/playground" style="max-width:100%;width:100%" class="f-1s3v5ik f-v-1a7rfw5 f-e7xpzw"><div class="f-1q6x1ck"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-12chao9"></div></div><div class="f-f5lzqk"><div class="f-foi0ng rt"><h1 class="p-2d95uh t8">Playground</h1></div><div class="f-1qalqtu rt"><p class="t9">Next project</p></div></div><div class="f-2h2af"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-19yczr0"></div></div></a></div></div><div class="ssr-variant hidden-il429r hidden-u7rrgr hidden-9p0tyo hidden-1fvlfgk hidden-1nmiogt"><div class="f-vafqxo-container"><a href="/playground" style="max-width:100%;width:100%" class="f-1s3v5ik f-v-1u7ogt4 f-e7xpzw"><div class="f-1q6x1ck"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-12chao9"></div></div><div class="f-f5lzqk"><div class="f-foi0ng rt"><h1 class="p-2d95uh t8">Playground</h1></div><div class="f-1qalqtu rt"><p class="t10">Next project</p></div></div><div class="f-2h2af"><div style="background-color:rgba(0, 0, 0, 0.4)" class="f-19yczr0"></div></div><div class="f-eoy0l3"><picture class="bg"><source type="image/avif" srcset="/img/goldcare-06-738.avif 738w, /img/goldcare-06-1475.avif 1475w" sizes="(max-width: 767.98px) min(100vw - 48px, 1400px)"><img src="/img/goldcare-06-1475.webp" srcset="/img/goldcare-06-738.webp 738w, /img/goldcare-06-1475.webp 1475w" sizes="(max-width: 767.98px) min(100vw - 48px, 1400px)" width="1475" height="1104" alt="" decoding="async" loading="lazy"></picture></div></a></div></div></div><div class="f-6ut3m4-container"></div><Footer kind="home" fixedHeight={515} motion={{ 'data-speed': 89, 'data-speed-lg': 87, 'data-speed-t': 85, 'data-speed-p': 78 }} /></div>
</Base>
